// Universal AMD optical flow: conservative colour-consistency and disocclusion handling.
// ABI-compatible with fsr3_frame_interpolation.comp (same four bindings / push constants).
// A lower-cost 5-tap motion-continuity test replaces the original 3x3 gather/median sorting.
#version 460 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D CurrentFrame;
layout(binding = 1) uniform sampler2D PreviousFrame;
layout(binding = 2) uniform sampler2D MotionVectors;
layout(binding = 3, rgba8) uniform writeonly image2D OutGeneratedFrame;
layout(push_constant) uniform PushConstants {
    vec2 inv_render_size;
    vec2 render_size;
    float blend_factor;
    float flow_scale;
};

float max3(vec3 x) { return max(x.r, max(x.g, x.b)); }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(render_size.x) || p.y >= int(render_size.y)) return;

    float t = clamp(blend_factor, 0.0, 1.0);
    vec2 uv = (vec2(p) + 0.5) * inv_render_size;
    // Motion texture is RG16F in motion-texture pixels. Its normalized direction
    // is prev_position - current_position; do not apply a second flow-scale.
    vec2 flow_size = vec2(textureSize(MotionVectors, 0));
    vec2 m = texture(MotionVectors, uv).xy;
    vec2 motion = m / flow_size;
    vec2 motion_px = motion * render_size;
    vec2 d = 1.0 / flow_size;

    // Abrupt vector discontinuity is a strong hint of an occluding foreground
    // silhouette: avoid dragging both silhouettes into the generated image.
    vec2 l = texture(MotionVectors, clamp(uv - vec2(d.x, 0.0), 0.0, 1.0)).xy;
    vec2 r = texture(MotionVectors, clamp(uv + vec2(d.x, 0.0), 0.0, 1.0)).xy;
    vec2 u = texture(MotionVectors, clamp(uv - vec2(0.0, d.y), 0.0, 1.0)).xy;
    vec2 v = texture(MotionVectors, clamp(uv + vec2(0.0, d.y), 0.0, 1.0)).xy;
    float spread = max(max(length(m - l), length(m - r)),
                       max(length(m - u), length(m - v)));
    float motion_edge = smoothstep(2.0, 18.0, spread * max(render_size.x / flow_size.x,
                                                            render_size.y / flow_size.y));

    vec4 prev_here = texture(PreviousFrame, uv);
    vec4 curr_here = texture(CurrentFrame, uv);
    vec2 prev_uv = clamp(uv + motion * t, vec2(0.0), vec2(1.0));
    vec2 curr_uv = clamp(uv - motion * (1.0 - t), vec2(0.0), vec2(1.0));
    vec4 prev_warp = texture(PreviousFrame, prev_uv);
    vec4 curr_warp = texture(CurrentFrame, curr_uv);

    // Cross-frame disagreement catches incorrect motion at reveals/occlusions.
    // Normalize by local brightness to avoid applying one absolute threshold
    // to both dark caves and bright scenes.
    float level = 0.5 * (dot(prev_warp.rgb, vec3(0.3333333)) +
                         dot(curr_warp.rgb, vec3(0.3333333)));
    float disagreement = max3(abs(prev_warp.rgb - curr_warp.rgb)) / (level + 0.10);
    float untrusted = max(smoothstep(0.24, 0.88, disagreement),
                          0.65 * motion_edge);

    // At untrusted pixels use the *nearest real* frame; mixing two unwarped
    // real frames would itself create double edges. Keep a small warped share
    // to avoid hard transitions into the protected region.
    vec4 warped = mix(prev_warp, curr_warp, t);
    vec4 nearest = t < 0.5 ? prev_here : curr_here;
    vec4 colour = mix(warped, nearest, 0.88 * untrusted);

    // HUD/text that is stationary in screen space should not inherit camera
    // motion. Require both real frames to agree on the same screen pixel.
    float hud_diff = max3(abs(prev_here.rgb - curr_here.rgb));
    float still_overlay = 1.0 - smoothstep(0.012, 0.045, hud_diff);
    float moving_background = smoothstep(1.5, 3.0, length(motion_px));
    colour = mix(colour, curr_here, 0.85 * still_overlay * moving_background);
    imageStore(OutGeneratedFrame, p, colour);
}
